{
  "name": "openapi-angular",
  "version": "0.0.0",
  "scripts": {
    "prepare": "husky",
    "ng": "ng",
    "start": "ng serve demo",
    "build:demo": "ng build demo",
    "test": "ng test",
    "lint": "eslint . --ext .ts,.html --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.html --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build:lib": "ng build openapi-angular --configuration production && cp README.md dist/openapi-angular && cp README.openapiResource.md dist/openapi-angular && cp LICENSE dist/openapi-angular",
    "publish:lib": "npm run build:lib && npm publish ./dist/openapi-angular"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "openapi-typescript-helpers": "^0.0.15",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^20.3.0",
    "@angular-eslint/eslint-plugin-template": "^20.3.0",
    "@angular/build": "^20.3.3",
    "@angular/cli": "^20.3.3",
    "@angular/compiler-cli": "^20.3.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-rxjs": "^5.0.3",
    "eslint-plugin-rxjs-angular": "^2.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "ng-packagr": "^20.3.0",
    "openapi-fetch": "^0.14.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "3.6.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
